# Your AssemblyAI key: https://www.assemblyai.com/dashboard
ASSEMBLYAI_API_KEY=

# The password people type to use the app. Pick something long (12+ characters).
ACCESS_CODE=

# Secret that signs login cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Optional: the LLM that scores your call (see the LLM Gateway model list)
# SCORING_MODEL=claude-sonnet-5-5
